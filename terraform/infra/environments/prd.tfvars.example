# Copy to prd.tfvars and fill in real values.
# prd.tfvars is gitignored — never commit it.

# ── Deployment target ─────────────────────────────────────────────────────────

environment     = "prd"
aws_region      = "us-west-2"
target_role_arn = "arn:aws:iam::<prd-account-id>:role/<role-name>"

# ── Application config ────────────────────────────────────────────────────────

plaid_env        = "production"
node_env         = "production"
refresh_schedule = "cron(0 12,18,0 * * ? *)"

# CORS origin — set this to your custom domain once DNS is pointed at AWS.
# allowed_origin = "https://<your-domain>"

# ── Custom domain (optional) ──────────────────────────────────────────────────
# Uncomment to enable ACM cert + API Gateway custom domain + Route53 DNS record.
# Route53 zone must be in the management account.
# custom_domain   = "<your-domain>"
# route53_zone_id = "<route53-hosted-zone-id>"

# ── Secrets ───────────────────────────────────────────────────────────────────

database_url      = "postgresql://..."
plaid_client_id   = ""
plaid_secret      = ""
session_secret    = ""
db_encryption_key = ""
