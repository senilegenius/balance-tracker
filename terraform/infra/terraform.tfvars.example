# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored and must never be committed.
#
# These values are personal/account-specific. Non-sensitive environment config
# lives in environments/sandbox.tfvars and environments/prd.tfvars.

# IAM role ARN in the target AWS account to assume for resource deployment.
# For sandbox: the role that allows deploying into your sandbox account.
# Find in your AWS config or IAM console.
target_role_arn = "arn:aws:iam::<account-id>:role/<role-name>"

# CORS origin — only set this when using a custom domain (e.g. prd with Route 53).
# When omitted, Terraform automatically uses the API Gateway URL. Safe to leave
# unset for sandbox.
# allowed_origin = "https://yourdomain.com"

# Application secrets — match the values in your .env.production
database_url      = "postgresql://..."
plaid_client_id   = ""
plaid_secret      = ""
session_secret    = ""
db_encryption_key = ""
