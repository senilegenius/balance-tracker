# Environment configuration template
#
# Local development with npm/Node:
#   cp .env.example .env
#
# Local development with Docker:
#   cp .env.example .env.local

# Plaid API
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# Database
# npm/Node workflow:  postgresql://localhost/balance_tracker
# Docker workflow:    postgresql://postgres:postgres@localhost:5433/balance_tracker
#   (docker-compose.yml overrides DATABASE_URL to db:5432 inside the container;
#    localhost:5433 is used by db_backup.sh to reach Docker Postgres from the host)
DATABASE_URL=postgresql://localhost/balance_tracker

# Security
DB_ENCRYPTION_KEY=your_encryption_key
SESSION_SECRET=your_session_secret

# App
NODE_ENV=development
# npm/Node workflow:  http://localhost:3000
# Docker workflow:    https://localhost
ALLOWED_ORIGIN=http://localhost:3000
