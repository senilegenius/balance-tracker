!build.sh

# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
# Environment files hold config + secrets — use terraform.tfvars.example as the template.
terraform/bootstrap/terraform.tfvars
terraform/sandbox/terraform.tfvars
terraform/prd/terraform.tfvars
# Backend config files contain account IDs — use backend.hcl.example as the template.
terraform/sandbox/backend.hcl
terraform/prd/backend.hcl
