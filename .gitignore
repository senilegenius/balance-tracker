.claude/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/settings.json
*.swp
*.swo

# Temporary files
*.tmp
*.temp
*.log
npm-debug.log*
backup_*.sql
backups/

# Keep config.js out of git (generated during build)
config.js
node_modules/
.env
.env.local
.env.production
plaid-token.json

